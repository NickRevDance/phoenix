-- Spec Section 8, test 7: reconciliation against legacy dw.d_Date.
-- VALIDATION-PHASE ONLY. Rename to remove the .disabled suffix once a
-- connection/external table for dw.d_Date (Azure SQL dwhvisualnext) is
-- available in the Databricks workspace, and adjust the source reference.
-- Remove the test after validation sign-off, when dw.d_Date is retired.

select d.date, d.calendar_year, d.month_number, d.fiscal_year, d.fiscal_month
from {{ ref('dim_date') }} d
inner join legacy.dw_d_date l          -- adjust to the actual external table
    on d.date = l.Date
where d.calendar_year <> l.Year
   or d.month_number  <> l.Month
   or d.fiscal_year   <> l.FiscalYear
   -- add fiscal month comparison if the legacy column exists with the same definition
